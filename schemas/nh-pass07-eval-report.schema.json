{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nh-family-law-llm.local/evals/pass07-report-v1.json",
  "title": "NH Pass 7 Engineering Evaluation Report",
  "type": "object",
  "required": [
    "schema",
    "status",
    "dataset_id",
    "review_mode",
    "attorney_reviewed",
    "private_data_training_allowed",
    "release_metric_eligible",
    "legal_advice",
    "filing_ready",
    "review_required",
    "dataset_sha256",
    "deterministic_result_sha256",
    "summary",
    "cases",
    "notices"
  ],
  "properties": {
    "schema": {
      "const": "nh_family_law_llm.pass07_eval_report.v1"
    },
    "status": {
      "enum": [
        "pass",
        "blocked"
      ]
    },
    "review_mode": {
      "const": "operator_source_backed"
    },
    "attorney_reviewed": {
      "const": false
    },
    "private_data_training_allowed": {
      "const": false
    },
    "release_metric_eligible": {
      "const": false
    },
    "dataset_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "deterministic_result_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "summary": {
      "type": "object"
    },
    "cases": {
      "type": "array",
      "minItems": 1
    },
    "notices": {
      "type": "array",
      "minItems": 1
    },
    "review_required": {
      "const": true
    },
    "filing_ready": {
      "const": false
    },
    "legal_advice": {
      "const": false
    }
  },
  "additionalProperties": true
}
