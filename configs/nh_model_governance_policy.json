{
  "version": "1.0.0-pass41",
  "governance_principle": "Models are replaceable workers. Legal validity is certified only by deterministic source registry, citation, quote, claim-support, filing-gate, and human-review controls.",
  "required_model_roles": [
    "nh_issue_classifier",
    "nh_procedural_posture_classifier",
    "nh_authority_ranker",
    "nh_rag_reranker",
    "nh_quote_verifier_assistant",
    "nh_claim_support_evaluator",
    "nh_draft_reviewer",
    "nh_challenger",
    "nh_final_generator"
  ],
  "required_admission_fields": [
    "model_id",
    "provider",
    "role",
    "version",
    "privacy_status",
    "allowed_tasks",
    "prohibited_tasks",
    "benchmark_scores",
    "failure_profile",
    "cost_profile",
    "latency_profile",
    "fallback_behavior",
    "eval_regression_history",
    "admission_status"
  ],
  "production_rules": {
    "requires_benchmark_scores": true,
    "requires_failure_profile": true,
    "requires_privacy_review": true,
    "requires_cost_and_latency_profile": true,
    "requires_regression_history": true,
    "generator_self_certification_allowed": false,
    "replacement_requires_ledger_event": true
  },
  "certification_tasks_reserved_to_system_gates": [
    "citation_validity_certification",
    "quote_validity_certification",
    "authority_validity_certification",
    "filing_ready_certification"
  ],
  "audit_trail_required_fields": [
    "event_id",
    "event_type",
    "old_model_id",
    "new_model_id",
    "role",
    "reason",
    "evidence_hash",
    "created_at",
    "event_hash"
  ]
}
