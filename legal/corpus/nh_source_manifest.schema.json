{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jtahai.github.io/nh-family-law-llm/schemas/nh_source_manifest.schema.json",
  "title": "New Hampshire official source acquisition manifest",
  "description": "Immutable acquisition metadata for official authority originals. A manifest record is technical provenance and never legal-review approval.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["source_id", "source_class", "jurisdiction", "retrieved_at", "hash", "parser_status", "freshness_status", "data_class", "source_url_or_path"],
    "properties": {
      "source_id": {"type": "string", "minLength": 1},
      "source_class": {"type": "string", "minLength": 1},
      "jurisdiction": {"const": "nh"},
      "retrieved_at": {"type": "string", "format": "date-time"},
      "hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
      "parser_status": {"type": "string", "minLength": 1},
      "freshness_status": {"type": "string", "minLength": 1},
      "data_class": {"type": "string", "minLength": 1},
      "source_url_or_path": {"type": "string", "minLength": 1},
      "final_url": {"type": "string"},
      "snapshot_path": {"type": "string"},
      "original_byte_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
      "normalized_text_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
      "parser_version": {"type": ["string", "null"]},
      "parser_audit": {"type": "object"},
      "use_restrictions": {
        "type": "object",
        "required": ["training_allowed_by_default", "release_packaging_allowed", "requires_human_review"],
        "properties": {
          "training_allowed_by_default": {"type": "boolean"},
          "release_packaging_allowed": {"type": "boolean"},
          "requires_human_review": {"const": true},
          "notes": {"type": "string"}
        }
      },
      "metadata": {"type": "object"}
    },
    "additionalProperties": true
  }
}
